{
  "name": "linkedin-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal LinkedIn assistant built with Google ADK and Gemini",
  "scripts": {
    "dev": "adk run src/agent.ts",
    "adk:web": "adk web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "research": "tsx src/research/cli.ts"
  },
  "dependencies": {
    "@google/adk": "^2.5.0",
    "dotenv": "^16.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@google/adk-devtools": "^2.5.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
